# Copy to .env.local for local development; set the same names in Vercel for production.

# Supabase project "irrigant-calls" (Project Settings -> API). Server-side only.
SUPABASE_URL=https://xrcrapywtxcrhmipparc.supabase.co
SUPABASE_SECRET_KEY=            # the secret key (sb_secret_...) or the legacy service_role key

# One shared password for the dashboard. Changing it signs everyone out.
DASHBOARD_PASSWORD=
# Optional: sign sessions with this instead of a hash of the password.
SESSION_SECRET=

# Retell: the API key, the outbound agent, and the number calls come from.
RETELL_API_KEY=                 # use the key with the webhook badge, or also set RETELL_WEBHOOK_KEY
RETELL_WEBHOOK_KEY=             # optional: the key Retell signs webhooks with, if different
RETELL_AGENT_ID=agent_910dadaa1d098ad48753758d1a   # "Helios outreach"
RETELL_TEST_AGENT_ID=agent_1eef8075091b8af62cd6c8e69e   # "Helios TEST ONLY": Script page's Test tab, rings only the test phone
RETELL_FROM_NUMBER=+12089283200

# The scheduler sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/dial. Any long random string.
CRON_SECRET=

# Set to 1 to run with made-up farms and no database (local development and screenshots).
DEMO_MODE=
